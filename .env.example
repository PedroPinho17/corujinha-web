# Garage (local) — gera chaves: openssl rand -hex 15 → prefixar GK; openssl rand -hex 32 (secret + rpc)
S3_ENDPOINT=http://127.0.0.1:3900
S3_PUBLIC_URL=http://corujinha-media.web.garage.localhost:3902
S3_REGION=garage
S3_ACCESS_KEY=GKabcdef0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET=corujinha-media
S3_FORCE_PATH_STYLE=true
S3_CORS_ORIGINS=http://localhost:3000
S3_PUBLIC_INCLUDE_BUCKET=false
GARAGE_RPC_SECRET=a1b2c3d4e5f60718293a4b5c6d7e8f90112233445566778899aabbccddeeff00
NEXT_PUBLIC_S3_PUBLIC_URL=http://corujinha-media.web.garage.localhost:3902
NEXT_PUBLIC_S3_BUCKET=corujinha-media

SMTP_HOST=127.0.0.1
