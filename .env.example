DATABASE_URL=postgresql://corujinha:corujinha@127.0.0.1:5434/corujinha?schema=public
REDIS_URL=redis://127.0.0.1:6381

POSTGRES_USER=corujinha
POSTGRES_PASSWORD=corujinha
POSTGRES_DB=corujinha

BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:3001
# Shared secret so Nest can bust Next Data Cache after Redis del() (optional locally).
REVALIDATE_SECRET=change-me-revalidate-secret
# Express trust proxy hops (Traefik→web→api = 1 no peer imediato). Rate-limit usa x-corujinha-client-ip.
TRUST_PROXY_HOPS=1
# false por omissão (staging / cópias de teste não entram no Google).
# Em produção no Coolify: ALLOW_SEARCH_INDEXING=true
ALLOW_SEARCH_INDEXING=false

# Garage (local) — gera chaves: openssl rand -hex 15 → prefixar GK; openssl rand -hex 32 (secret + rpc)
S3_ENDPOINT=http://127.0.0.1:3900
S3_PUBLIC_URL=http://corujinha-media.web.garage.localhost:3902
S3_REGION=garage
S3_ACCESS_KEY=GKabcdef0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_BUCKET=corujinha-media
S3_FORCE_PATH_STYLE=true
S3_CORS_ORIGINS=http://localhost:3000
S3_PUBLIC_INCLUDE_BUCKET=false
GARAGE_RPC_SECRET=a1b2c3d4e5f60718293a4b5c6d7e8f90112233445566778899aabbccddeeff00
NEXT_PUBLIC_S3_PUBLIC_URL=http://corujinha-media.web.garage.localhost:3902
NEXT_PUBLIC_S3_BUCKET=corujinha-media

SMTP_HOST=127.0.0.1
SMTP_PORT=1026
# true|false — se omisso, secure só na porta 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@corujinha.local
CONTACT_NOTIFY_TO=notify@ninhodacoruja.pt
# Meses até anonimização automática das mensagens de contacto (RGPD). Default 24.
# Definir o mesmo valor na API e na web (página /privacidade).
CONTACT_RETENTION_MONTHS=24
NEXT_PUBLIC_CONTACT_RETENTION_MONTHS=24
ALLOW_INSECURE_S3=true

DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Seed — obrigatório; mín. 12 caracteres; sem defaults fracos (ex.: Admin123!)
ADMIN_EMAIL=admin@corujinha.local
ADMIN_PASSWORD=
ADMIN_NAME=Admin Corujinha
WEBAUTHN_RP_ID=localhost

BRANDING_NAME=Corujinha

# Site público — contactos / Google (opcional; nunca inventar ratings)
NEXT_PUBLIC_WHATSAPP_PHONE=+351916280509
NEXT_PUBLIC_GOOGLE_PLACE_URL=https://www.google.com/maps/place/Corujinha/@40.9678744,-8.4903562,17z/data=!3m1!4b1!4m6!3m5!1s0xd247f83484b6231:0x9c3013157ecde0bd!8m2!3d40.9678744!4d-8.4903562!16s%2Fg%2F11kc28q8g1
# Fallback estático se Places API estiver desligada / falhar (preferir GOOGLE_PLACES_*)
# NEXT_PUBLIC_GOOGLE_RATING=5.0
# NEXT_PUBLIC_GOOGLE_REVIEW_COUNT=18

# Google Places API (New) — servidor apenas; cache Redis 24h em /api/public/google-place
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Legacy Laravel import (pnpm migrate:legacy)
LEGACY_MYSQL_URL=mysql://root@127.0.0.1:3306/corujinha_db
LEGACY_PUBLIC_DIR=C:\Projetos_WEB\corujinha\public
LEGACY_USER_TEMP_PASSWORD=
