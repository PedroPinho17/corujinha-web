{
  "name": "@corujinha/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typeorm": "tsx ./node_modules/typeorm/cli.js -d src/data-source.ts",
    "migrate:dev": "pnpm typeorm migration:run",
    "migrate:deploy": "pnpm typeorm migration:run",
    "migrate:revert": "pnpm typeorm migration:revert",
    "seed": "tsx src/seed.ts",
    "lint": "echo ok"
  },
  "dependencies": {
    "@corujinha/shared": "workspace:*",
    "@hedystia/better-auth-typeorm": "^1.1.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "^1.7.7",
    "dotenv": "^17.4.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
