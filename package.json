{
  "name": "corujinha",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --filter=@corujinha/api --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "docker:up": "docker compose --profile local up -d redis garage mailpit",
    "docker:down": "docker compose --profile local down",
    "test": "pnpm --filter @corujinha/api test",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "verify:production": "node scripts/verify-production.mjs",
    "typecheck": "pnpm --filter @corujinha/api typecheck && pnpm --filter web exec tsc --noEmit",
    "db:migrate": "pnpm --filter @corujinha/database migrate:dev",
    "db:deploy": "pnpm --filter @corujinha/database migrate:deploy",
    "db:seed": "pnpm --filter @corujinha/database seed",
    "migrate:legacy": "tsx --env-file=.env scripts/migrate-legacy.ts",
    "sync:legacy-media": "tsx --env-file=.env scripts/sync-legacy-media.ts",
    "generate:favicons": "node scripts/generate-favicons.mjs"
  },
  "devDependencies": {
    "@corujinha/database": "workspace:*",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.32",
    "better-auth": "^1.7.18",
    "dotenv": "^17.4.2",
    "mysql2": "^3.14.2",
    "sharp": "^0.35.5",
    "tsx": "^4.20.3",
    "turbo": "^2.11.3",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "follow-redirects": ">=1.16.2",
      "adm-zip": "0.6.1",
      "proxy-addr": "2.0.8",
      "postcss": "8.5.30",
      "sharp": "0.35.5",
      "multer": "2.5.0",
      "body-parser": "2.4.0",
      "nodemailer": "10.0.9",
      "fast-uri": "3.1.8",
      "brace-expansion": "2.1.7",
      "deepmerge-ts": "8.0.0",
      "qs": "6.16.1",
      "next": "15.5.28",
      "prisma": "-",
      "@prisma/client": "-",
      "@better-auth/prisma-adapter": "-"
    }
  }
}
