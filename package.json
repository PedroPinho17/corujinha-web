{
  "name": "corujinha",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --filter=@corujinha/api --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "docker:up": "docker compose --profile local up -d",
    "docker:down": "docker compose --profile local down",
    "test": "pnpm --filter @corujinha/api test",
    "typecheck": "pnpm --filter @corujinha/api typecheck && pnpm --filter web exec tsc --noEmit",
    "db:generate": "pnpm --filter @corujinha/database generate",
    "db:migrate": "prisma migrate dev --schema=packages/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/prisma/seed.ts",
    "db:studio": "prisma studio --schema=packages/database/prisma/schema.prisma",
    "migrate:legacy": "tsx --env-file=.env scripts/migrate-legacy.ts",
    "sync:legacy-media": "tsx --env-file=.env scripts/sync-legacy-media.ts",
    "generate:favicons": "node scripts/generate-favicons.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.840.0",
    "@prisma/client": "^6.11.1",
    "@types/node": "^22.15.32",
    "better-auth": "^1.2.12",
    "dotenv": "^17.4.2",
    "mysql2": "^3.14.2",
    "prisma": "^6.11.1",
    "sharp": "^0.35.5",
    "tsx": "^4.20.3",
    "turbo": "^2.11.3",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "adm-zip": "0.6.1",
      "proxy-addr": "2.0.8",
      "postcss": "8.5.30",
      "sharp": "0.35.5",
      "multer": "2.4.0",
      "nodemailer": "10.0.9",
      "fast-uri": "3.1.8",
      "brace-expansion": "2.1.7",
      "deepmerge-ts": "8.0.0",
      "qs": "6.16.1",
      "next": "15.5.28"
    }
  }
}
